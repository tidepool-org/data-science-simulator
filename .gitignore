# ---- Tidepool ----

# Personal health info
phi-*
PHI-*

# Data Science large data
*nogit*

# Pycharm
.idea/

# Python
*.pyc

# Mac OS
.DS_Store

*.log
data/
figures/

# Swift Loop algorithm per-control-cycle I/O. SwiftLoopController falls back to
# the working directory when loop_algo_io_dir is unset, and a 3 x 23 h run
# writes roughly 1,100 of these to the repository root.
loop_algo_input_*.json
loop_algo_output_*.json

# Architecture diagram generator (TRSET-51). The filtered trace is a local
# diagnostic, ~7 MB per run, and nothing downstream reads it back: the figures
# and the coverage report are derived during the run that writes it. The other
# four artifacts in that directory ARE committed.
.docs/architecture/trace.jsonl
# Same, for the per-scenario output directories under .docs/architecture/<ticket>/.
.docs/architecture/**/trace.jsonl

# Physical activity model test output. test_physical_activity_model.py writes a
# timestamped CSV and PNG per activity profile into tests/test_data/ on every
# run, so they accumulate instead of being overwritten. Scoped to the pa_test_
# prefix: tests/test_data/ also holds real committed fixtures.
tests/test_data/pa_test_*


# ---- Catch all ----

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

